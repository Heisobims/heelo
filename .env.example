# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Heelo
APP_ENV=development
SECRET_KEY=change-me-to-a-random-64-char-string
FRONTEND_URL=http://localhost:8000
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://heelo:heelo@localhost:5432/heelo
DATABASE_URL_SYNC=postgresql+psycopg2://heelo:heelo@localhost:5432/heelo

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Auth ──────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_EXPIRE_MINUTES=10

# ── OAuth ─────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ── Email — Resend ────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@heelo.io
RESEND_FROM_NAME=Heelo

# ── SMS — Termii ──────────────────────────────────────────────────────────────
TERMII_API_KEY=
TERMII_SENDER_ID=Heelo

# ── SMS — Twilio (fallback) ───────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── WhatsApp — Meta Cloud API ─────────────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ── Payments — Paystack ───────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ── Payments — Flutterwave ────────────────────────────────────────────────────
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=

# ── Payments — Stripe ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# ── AI — Anthropic ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Storage — Cloudflare R2 ───────────────────────────────────────────────────
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=heelo-media
CLOUDFLARE_R2_PUBLIC_URL=https://media.heelo.io

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO

# ── Database pool (tune per gunicorn worker count) ───────────────────────────
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── Production / Docker ───────────────────────────────────────────────────────
# PostgreSQL password used by docker-compose (replaces hardcoded "heelo" default)
POSTGRES_PASSWORD=change-me-strong-password

# Redis password (leave blank to disable auth in dev)
REDIS_PASSWORD=

# Gunicorn worker count (defaults to cpu_count*2+1 if unset)
WEB_CONCURRENCY=

# Celery worker concurrency per container
CELERY_CONCURRENCY=4

# Flower basic-auth (task monitoring dashboard)
FLOWER_USER=admin
FLOWER_PASSWORD=change-me-flower-password
